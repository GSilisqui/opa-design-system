{
  "$description": "Famílias e escala de texto. Nomes do Tailwind com os valores dos estilos Default/{tamanho}/* do Figma (letter-spacing 0 em todos, omitido). Pesos usam os padrões do Tailwind (400/500/700).",
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["Inter Variable", "Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
    "mono": { "$value": ["JetBrains Mono Variable", "JetBrains Mono", "ui-monospace", "monospace"] }
  },
  "text": {
    "$type": "dimension",
    "xs": { "size": { "$value": "0.625rem" }, "line-height": { "$value": "0.75rem" } },
    "sm": { "size": { "$value": "0.75rem" }, "line-height": { "$value": "1rem" } },
    "base": { "size": { "$value": "0.875rem" }, "line-height": { "$value": "1.25rem" } },
    "lg": { "size": { "$value": "1rem" }, "line-height": { "$value": "1.5rem" } },
    "xl": { "size": { "$value": "1.125rem" }, "line-height": { "$value": "1.625rem" } },
    "2xl": { "size": { "$value": "1.25rem" }, "line-height": { "$value": "1.75rem" } },
    "3xl": { "size": { "$value": "1.5rem" }, "line-height": { "$value": "2rem" } },
    "4xl": { "size": { "$value": "1.75rem" }, "line-height": { "$value": "2.5rem" } },
    "5xl": { "size": { "$value": "2rem" }, "line-height": { "$value": "2.5rem" } },
    "6xl": { "size": { "$value": "2.5rem" }, "line-height": { "$value": "3.125rem" } },
    "7xl": { "size": { "$value": "3rem" }, "line-height": { "$value": "3.75rem" } },
    "8xl": { "size": { "$value": "4rem" }, "line-height": { "$value": "5rem" } },
    "9xl": { "size": { "$value": "5rem" }, "line-height": { "$value": "6rem" } }
  }
}
