        "css": "--opa-<grupo>-<degrau> (ex.: --opa-brand-600)",
        "source": "packages/tokens/src/primitives.json",
        "rule": "Nunca usar direto em componentes ou telas (lint `primitive`). Só a camada Semantic/Component referencia primitivos."
